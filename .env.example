# =============================================================================
# SiliconSoup API — Environment Variables
# Copy to api/.env for local development.
# Production vars are set directly in Railway (API) and /var/www/siliconsoup/.env (VPS).
# =============================================================================

# --- Database ---
DATABASE_URL=

# --- Server ---
PORT=8080
ENVIRONMENT=  # development | production

# --- Site ---
# Leave blank to auto-detect from 'siliconsoup' slug in DB
SITE_ID=

# --- Admin ---
# Bearer token required for all /api/admin/* endpoints
ADMIN_API_KEY=

# --- PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox  # sandbox | live

# --- SMTP (order notification + contact form emails) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Email address that receives new order notifications
ORDER_NOTIFICATION_EMAIL=

# --- Translations (MyMemory API) ---
# Use Paul's Gardapis email for 10k words/day free tier
MYMEMORY_EMAIL=

# --- Push Notifications (ntfy.sh) ---
# Optional — leave blank to disable
NTFY_TOPIC=
