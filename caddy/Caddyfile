# =============================================================================
# TEMPORARY — IP-based, HTTP only (no domains yet)
# Use this until DNS is pointed at the VPS.
# Copy to /etc/caddy/Caddyfile on the VPS.
# =============================================================================

:80 {
    # Admin SPA — SPA fallback so React Router works on page refresh
    root * /var/www/admin
    try_files {path} /index.html
    file_server
}

